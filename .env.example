# Public browser configuration. Copy to .env.local for a local production preview.
VITE_TELEMETRY_ENABLED=false
VITE_TELEMETRY_ALLOWED_HOSTS=ajwa2-collection.vercel.app
VITE_POSTHOG_PROJECT_TOKEN=
# Use the host shown in your PostHog project settings (EU or US).
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_PERFORMANCE_SAMPLE_RATE=0.1
# Optional Vercel RES score. Detailed metrics are sent to PostHog separately.
VITE_SPEED_INSIGHTS_ENABLED=true
# Defaults to the deployment's commit SHA.
VITE_APP_RELEASE=

# Private build-only configuration: set in Vercel, never prefix with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
